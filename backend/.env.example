# ==========================================
# INVY Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# ==========================================
# PostgreSQL Connection Configuration
# ==========================================
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example: postgresql://postgres:mypassword@localhost:5432/invoicedb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoicedb

# Individual DB fields (if you prefer configuring separately):
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=invoicedb
